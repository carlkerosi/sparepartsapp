rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Supplier Validation
    function isValidSupplier(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.code is string && data.code.size() > 0 && data.code.size() <= 30
        && data.paymentTerms is string && data.paymentTerms.size() <= 60
        && (!('status' in data) || data.status in ['ACTIVE', 'INACTIVE', 'UNDER_REVIEW'])
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('physicalAddress' in data) || (data.physicalAddress is string && data.physicalAddress.size() <= 250))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('shippingTerms' in data) || (data.shippingTerms is string && data.shippingTerms.size() <= 60))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('leadTimeDays' in data) || (data.leadTimeDays is number && data.leadTimeDays >= 0))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5));
    }

    // 2. SparePart Validation
    function isValidPart(data) {
      return data.partNumber is string && data.partNumber.size() > 0 && data.partNumber.size() <= 60
        && data.description is string && data.description.size() > 0 && data.description.size() <= 250
        && data.unitCostFobUsd is number && data.unitCostFobUsd >= 0
        && data.unitCostLanded is number && data.unitCostLanded >= 0
        && data.retailPriceEx is number && data.retailPriceEx >= 0
        && data.retailPriceInc is number && data.retailPriceInc >= 0
        && data.stockQuantity is number && data.stockQuantity >= 0
        && (!('minStockLevel' in data) || (data.minStockLevel is number && data.minStockLevel >= 0))
        && (!('category' in data) || (data.category is string && data.category.size() <= 60))
        && (!('location' in data) || (data.location is string && data.location.size() <= 80))
        && (!('oemReference' in data) || (data.oemReference is string && data.oemReference.size() <= 100))
        && (!('vehicleCompatibility' in data) || (data.vehicleCompatibility is string && data.vehicleCompatibility.size() <= 250))
        && (!('supplierId' in data) || (data.supplierId is string && data.supplierId.size() <= 128))
        && (!('supplier' in data) || (data.supplier is string && data.supplier.size() <= 150))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2500000));
    }

    // 3. SaleRecord Validation
    function isValidSale(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() > 0 && data.invoiceNumber.size() <= 50
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.subtotalEx is number && data.subtotalEx >= 0
        && data.totalInc is number && data.totalInc >= 0
        && data.paymentMethod is string && data.paymentMethod.size() <= 50
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 250))
        && (!('mpesaReceiptNumber' in data) || (data.mpesaReceiptNumber is string && data.mpesaReceiptNumber.size() <= 60))
        && (!('vehicleRef' in data) || (data.vehicleRef is string && data.vehicleRef.size() <= 100))
        && (!('salesPerson' in data) || (data.salesPerson is string && data.salesPerson.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // 4. StockMovement Validation
    function isValidMovement(data) {
      return data.partId is string && data.partId.size() > 0 && data.partId.size() <= 128
        && data.partNumber is string && data.partNumber.size() > 0 && data.partNumber.size() <= 60
        && data.type is string && data.type.size() <= 40
        && data.quantityDelta is number
        && data.previousStock is number && data.previousStock >= 0
        && data.newStock is number && data.newStock >= 0
        && (!('referenceDoc' in data) || (data.referenceDoc is string && data.referenceDoc.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('user' in data) || (data.user is string && data.user.size() <= 80));
    }

    // Collection Rules
    match /suppliers/{supplierId} {
      allow read: if true;
      allow create, update: if isValidId(supplierId) && isValidSupplier(incoming());
      allow delete: if isValidId(supplierId);
    }

    match /parts/{partId} {
      allow read: if true;
      allow create, update: if isValidId(partId) && isValidPart(incoming());
      allow delete: if isValidId(partId);
    }

    match /sales/{saleId} {
      allow read: if true;
      allow create: if isValidId(saleId) && isValidSale(incoming());
      allow update, delete: if isValidId(saleId);
    }

    match /movements/{movementId} {
      allow read: if true;
      allow create: if isValidId(movementId) && isValidMovement(incoming());
      allow update, delete: if false; // Audit trail is immutable
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Test connection probe
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
